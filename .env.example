# ============================================================
# SOS Clinic - plantilla de credenciales de DESARROLLO
#
# COMO USARLO:
#   1. Copia este archivo y renombralo a .env  (cp .env.example .env)
#   2. Pide los valores al coordinador del proyecto por un canal
#      seguro (gestor de contrasenas compartido o mensaje PRIVADO).
#      NUNCA los pidas ni los compartas en grupos publicos.
#   3. .env esta en .gitignore: jamas se sube a git.
#
# NUNCA escribas credenciales reales en este archivo .example.
# ============================================================

# Secreto HS256 compartido por todos los microservicios.
# Genera uno con al menos 32 bytes, por ejemplo:
#   openssl rand -base64 64
# Debe ser el mismo en gateway, seguridad, pacientes, triage, analitica y agente.
APP_JWT_SECRET=

# PostgreSQL local
DB_USERNAME=sos_admin
DB_PASSWORD=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_PASSWORD=

# CORS: origenes permitidos del frontend
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# SMTP real (Gmail con contrasena de aplicacion).
# Para pruebas usa una cuenta y destinatarios de prueba; no envies datos reales.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# MySQL local de analitica
ANALITICA_DB_USERNAME=
ANALITICA_DB_PASSWORD=

# API key de Groq para el agente IA
GROQ_API_KEY=
