# Plantilla de variables para el despliegue Azure.
#
# NO edites este archivo para desplegar: deploy.ps1 genera
# infra/azure/.env.azure (ignorado por Git) con valores aleatorios y permisos
# restringidos. Esta plantilla sirve como referencia y para revisar que claves
# necesita el stack.
#
# Los valores marcados como GENERAR los crea el script. Los de correo y Groq
# se copian del .env local en el primer despliegue.

# Dominio publico: <dns-label>.<region>.cloudapp.azure.com
SOS_DOMAIN=sos-clinic-demo.eastus2.cloudapp.azure.com
ACME_EMAIL=pruebasosclinic@gmail.com

# Azure Container Registry y tag de las 7 imagenes
ACR_NAME=sosclinicdemo
ACR_LOGIN_SERVER=sosclinicdemo.azurecr.io
IMAGE_TAG=20261025-120000-abcdef0

# Almacenamiento de backups
STORAGE_ACCOUNT=sosclinicbackups
BACKUP_CONTAINER=sos-clinic-backups

# PostgreSQL (contenedor sos-postgres, puerto 5433 en loopback)
DB_USERNAME=sos_admin
DB_PASSWORD=GENERAR
POSTGRES_PASSWORD=GENERAR

# MySQL de analitica (contenedor sos-mysql, puerto 3306 en loopback)
ANALITICA_DB_USERNAME=root
ANALITICA_DB_PASSWORD=GENERAR

# JWT compartido por los 7 servicios (>= 32 bytes; el script genera 128 hex)
APP_JWT_SECRET=GENERAR

# SMTP y 2FA. MAIL_PASSWORD es una contrasena de aplicacion de Gmail.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USERNAME=sosclinicnoreply@gmail.com
MAIL_PASSWORD=GENERAR_O_COPIAR_DEL_ENV_LOCAL

# API de Groq para ms-ia-agente
GROQ_API_KEY=GENERAR_O_COPIAR_DEL_ENV_LOCAL

# Origen permitido por el gateway y enlaces de correo
CORS_ALLOWED_ORIGINS=https://sos-clinic-demo.eastus2.cloudapp.azure.com
FRONTEND_URL=https://sos-clinic-demo.eastus2.cloudapp.azure.com

TZ=America/Bogota
